{
  "name": "visual-notes",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "panda codegen && vinxi dev",
    "build": "panda codegen && vinxi build && pnpm build:search-text",
    "start": "vinxi start",
    "start-prod": "pnpm prisma migrate deploy && node .output/backfill-search-text.mjs && pnpm start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fix:unstaged": "sh -c 'app_files=$(git diff --name-only --diff-filter=ACMR | grep \"^app/\" | sed \"s#^app/##\"); if [ -z \"$app_files\" ]; then echo \"No unstaged files under app/.\"; exit 0; fi; lint_files=$(printf \"%s\\n\" \"$app_files\" | grep -E \"\\\\.(ts|tsx|js|jsx)$\" || true); if [ -n \"$lint_files\" ]; then printf \"%s\\n\" \"$lint_files\" | xargs pnpm exec oxlint --fix; fi; printf \"%s\\n\" \"$app_files\" | xargs pnpm exec prettier --write --ignore-unknown'",
    "panda": "panda codegen",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:json": "playwright test --reporter=list,json",
    "test:e2e:install": "playwright install chromium webkit",
    "audit:harness": "node --experimental-strip-types scripts/audit-harness.ts",
    "audit:harness:check": "node --experimental-strip-types scripts/audit-harness.ts --self-check",
    "audit:fixtures": "node --experimental-strip-types scripts/audit-fixtures.ts",
    "audit:run": "node --experimental-strip-types scripts/audit-run.ts",
    "audit:shoot": "node scripts/audit-shoot.mjs",
    "audit:db": "node --experimental-strip-types scripts/audit-db.ts",
    "audit:seed-scale": "vite-node --config vitest.config.ts scripts/audit-seed-scale.ts --",
    "audit:seed-cleanup": "vite-node --config vitest.config.ts scripts/audit-seed-cleanup.ts --",
    "research:seed": "node scripts/research-seed.mjs",
    "pgm:report": "node --experimental-strip-types scripts/pgm-report.ts",
    "mcp:playwright": "pnpm dlx @playwright/mcp@latest --isolated",
    "umap:setup:local": "node scripts/setup-umap-local.mjs",
    "umap:python:install": "python3 -m venv .venv && ./.venv/bin/python -m pip install -r scripts/requirements-umap.txt",
    "umap:python:check": "UMAP_PYTHON_BIN=${UMAP_PYTHON_BIN:-$PWD/.venv/bin/python} ${UMAP_PYTHON_BIN:-$PWD/.venv/bin/python} scripts/umap_model.py check --output /tmp/vn-umap-check.json && cat /tmp/vn-umap-check.json",
    "push": "prisma db push",
    "postinstall": "prisma generate",
    "knip": "pnpm dlx knip",
    "type-check": "node node_modules/typescript7/bin/tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/type-check.tsbuildinfo && echo 'Type check passed'",
    "migrate:blocks": "vite-node --config vitest.config.ts scripts/migrate-block-content.ts --",
    "build:search-text": "esbuild scripts/backfill-search-text.ts --bundle --platform=node --format=esm --packages=external --outfile=.output/backfill-search-text.mjs"
  },
  "type": "module",
  "devDependencies": {
    "@pandacss/dev": "^1.7.2",
    "@playwright/test": "^1.56.1",
    "@types/hast": "^3.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/leaflet": "^1.9.22",
    "@types/mustache": "^4.2.6",
    "@types/node": "^20.19.19",
    "@types/turndown": "^5.0.6",
    "esbuild": "0.25.10",
    "eslint-plugin-solid": "^0.14.3",
    "js-yaml": "4.1.0",
    "oxlint": "1.89.0",
    "prisma": "^6.5.0",
    "solid-devtools": "^0.34.4",
    "typescript": "^5.6.2",
    "typescript7": "npm:typescript@7.0.2",
    "vite": "^6.2.2",
    "vite-node": "2.1.9",
    "vite-plugin-lucide-preprocess": "^1.4.6",
    "vite-tsconfig-paths": "^6.0.3",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@ark-ui/solid": "^5.30.0",
    "@auth/core": "^0.38.0",
    "@auth/prisma-adapter": "^2.8.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@prisma/client": "^6.5.0",
    "@solid-devtools/overlay": "^0.33.5",
    "@solid-mediakit/auth": "^3.1.3",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^0.15.1",
    "@solidjs/start": "^1.1.3",
    "@tanstack/solid-query": "^5.69.0",
    "@tiptap/core": "^3.7.2",
    "@tiptap/extension-code": "^3.7.2",
    "@tiptap/extension-code-block-lowlight": "^3.8.0",
    "@tiptap/extension-emoji": "^3.7.2",
    "@tiptap/extension-highlight": "^3.7.2",
    "@tiptap/extension-image": "^3.7.2",
    "@tiptap/extension-table": "^3.9.0",
    "@tiptap/extension-table-cell": "^3.9.0",
    "@tiptap/extension-table-header": "^3.9.0",
    "@tiptap/extension-table-row": "^3.9.0",
    "@tiptap/html": "3.7.2",
    "@tiptap/pm": "3.7.2",
    "@tiptap/starter-kit": "^3.7.2",
    "@tiptap/suggestion": "^3.7.2",
    "@types/sanitize-html": "^2.16.0",
    "autoprefixer": "^10.4.19",
    "bcryptjs": "^3.0.2",
    "highlight.js": "^11.11.1",
    "htmlparser2": "8.0.2",
    "leaflet": "^1.9.4",
    "lowlight": "^3.3.0",
    "lucide-solid": "^0.562.0",
    "marked": "^16.4.1",
    "mustache": "^4.2.0",
    "postcss": "^8.4.40",
    "prosemirror-state": "^1.4.4",
    "sanitize-html": "^2.17.0",
    "shiki": "^3.13.0",
    "solid-js": "^1.9.5",
    "solid-tiptap": "^0.8.0",
    "svd-js": "^1.1.1",
    "tailwindcss": "^3.4.7",
    "tippy.js": "^6.3.7",
    "turndown": "7",
    "umap-js": "^1.4.0",
    "vinxi": "^0.5.10",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=16"
  },
  "pnpm": {
    "patchedDependencies": {
      "vinxi@0.5.10": "patches/vinxi@0.5.10.patch"
    }
  }
}
