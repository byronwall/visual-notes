generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? // @db.Text
  access_token      String? // @db.Text
  expires_in        Int?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? // @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  // Password hash for Credentials provider auth (nullable to allow future OAuth)
  passwordHash  String?
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// --- AI Prompting & Evals ---

enum RunStatus {
  SUCCESS
  ERROR
  PARTIAL
}

enum ActionActorType {
  magic_user
  anonymous
  system
  chatgpt
}

enum ActionActivityClass {
  READ_HEAVY
  EDIT_HEAVY
  BALANCED
  COLD
}

enum ArchivedCanvasNodeKind {
  note
  image
}

/// Single prompt per task (e.g., "chapter_summary") with default model/params
model Prompt {
  id              String          @id @default(cuid())
  task            String          @unique
  description     String?
  defaultModel    String          @default("gpt-4o-mini")
  defaultTemp     Float           @default(0.2)
  defaultTopP     Float?
  activeVersionId String?         @unique
  activeVersion   PromptVersion?  @relation("ActivePromptVersion", fields: [activeVersionId], references: [id])
  versions        PromptVersion[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

/// Immutable template version; may override model params for rare A/B
model PromptVersion {
  id            String   @id @default(cuid())
  promptId      String
  template      String
  system        String?
  modelOverride String?
  tempOverride  Float?
  topPOverride  Float?
  metadata      Json?
  createdById   String?
  createdAt     DateTime @default(now())

  PromptRun PromptRun[]
  Prompt    Prompt?     @relation(fields: [promptId], references: [id])
  activeFor Prompt?     @relation("ActivePromptVersion")

  @@index([promptId, createdAt])
}

/// Run log for prompt generations
model PromptRun {
  id              String          @id @default(cuid())
  promptVersionId String
  promptVersion   PromptVersion   @relation(fields: [promptVersionId], references: [id], onDelete: Cascade)
  model           String
  inputVars       Json
  compiledPrompt  String
  systemUsed      String?
  outputHtml      String?
  rawResponse     Json?
  usage           Json?
  status          RunStatus       @default(SUCCESS)
  error           String?
  qaTranscript    Json?
  createdAt       DateTime        @default(now())
  userId          String?
  // Optional link to a note/document this run was made against
  noteId          String?
  HumanFeedback   HumanFeedback[]

  @@index([promptVersionId, createdAt])
}

model HumanFeedback {
  id          String    @id @default(cuid())
  promptRunId String
  promptRun   PromptRun @relation(fields: [promptRunId], references: [id], onDelete: Cascade)
  rating      Int?
  comment     String?
  createdById String?
  createdAt   DateTime  @default(now())
}

/// Centralized log of all LLM requests, regardless of feature
model LlmRequest {
  id               String    @id @default(cuid())
  createdAt        DateTime  @default(now())
  // Inputs
  model            String
  system           String?
  userPrompt       String // @db.Text
  temperature      Float?
  topP             Float?
  // Outputs
  status           RunStatus @default(PARTIAL)
  outputText       String?
  rawResponse      Json?
  usage            Json?
  // Token info (normalized across providers)
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  // Error message if any
  error            String?
  // Optional link to a note/document this request was made against
  noteId           String?

  @@index([createdAt])
}

/// Minimal document for Markdown ingest
model Doc {
  id                         String   @id @default(cuid())
  title                      String
  // Canonical note body: TipTap JSON with a stable id on every block.
  content                    Json?
  contentSchemaVersion       Int      @default(1)
  // Increments on every content write; saves carry it for per-block merge.
  contentVersion             Int      @default(0)
  // Plain text for indexed keyword search; derived on every content write.
  searchText                 String?
  // Legacy string bodies, derived from `content` until the cutover is confirmed.
  markdown                   String // @db.Text
  html                       String // @db.Text
  // Source + content id form a stable identity for ingest pipelines
  originalSource             String?
  originalContentId          String?
  contentHash                String?
  // Dot path for filtering/nesting (e.g., "work.projects.alpha")
  path                       String?
  // Arbitrary single-level key/value pairs from client (stored as JSONB)
  meta                       Json?
  // Backup snapshot captured before inline data-image migration rewrites.
  inlineImageMigrationBackup Json?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  // Relations
  docEmbeddings        DocEmbedding[]
  umapPoints           UmapPoint[]
  sections             DocSection[]
  docSectionEmbeddings DocSectionEmbedding[]
  actionEvents         ActionEvent[]          @relation("RelatedDocEvents")
  activityDaily        DocActivityDaily[]
  activitySnapshot     DocActivitySnapshot?
  share                DocShare?
  timeBlocks           TimeBlock[]
  timeBlockDayMetadata TimeBlockDayMetadata[]
  revisions            DocRevision[]
  blocks               DocBlock[]
  outgoingLinks        DocLink[]              @relation("DocLinkSource")
  incomingLinks        DocLink[]              @relation("DocLinkTarget")
  inlineTasks          TaskItem[]
  audioRecordings      DocAudio[]

  // Collections: a note can be a row in at most one collection. Values are
  // keyed by CollectionProperty id; they are kept if the note leaves the
  // collection so re-adding restores them.
  collectionId   String?
  properties     Json?
  collectionRank String?
  collection     Collection?      @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  hostedViews    CollectionView[] @relation("CollectionViewHost")

  // Events: set when this note is an event (see Event) or a place write-up.
  event Event?
  place Place?

  @@unique([originalSource, originalContentId])
  @@index([path])
  @@index([collectionId])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

// An audio recording attached to a note. The audio lives on disk (see
// server/notes/doc-audio-storage.ts); chunks are appended while recording so
// an interrupted session still leaves a playable file.
model DocAudio {
  id         String         @id @default(cuid())
  docId      String
  // User-editable name; null falls back to the recording time in the UI.
  label      String?
  mimeType   String
  fileName   String         @unique
  status     DocAudioStatus @default(recording)
  // Next chunk sequence number expected; also the count of stored chunks.
  chunkCount Int            @default(0)
  sizeBytes  Int            @default(0)
  // Elapsed recording time reported with the latest chunk or on finish.
  durationMs Int            @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  doc Doc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([docId, createdAt])
}

enum DocAudioStatus {
  recording
  ready
}

/// Prior content captured before an automated edit (e.g. ChatGPT via MCP)
/// so the change can be rolled back from the app.
// Derived index of a note's blocks, rebuilt from Doc.content on every write.
// Keyed by (docId, id): a block copied into another note keeps its id there too.
model DocBlock {
  docId         String
  id            String
  parentId      String?
  // Index of the top-level block this block belongs to.
  topLevelIndex Int
  // Document order across all blocks in the note.
  orderIndex    Int
  type          String
  text          String
  tags          String[] @default([])
  attrs         Json?
  hash          String

  doc Doc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@id([docId, id])
  @@index([id])
  @@index([tags], type: Gin)
}

// Derived index of note links ([[note]] / [[note#block]]), rebuilt on write.
model DocLink {
  id            String  @id @default(cuid())
  sourceDocId   String
  sourceBlockId String
  targetDocId   String
  targetBlockId String?

  sourceDoc Doc @relation("DocLinkSource", fields: [sourceDocId], references: [id], onDelete: Cascade)
  targetDoc Doc @relation("DocLinkTarget", fields: [targetDocId], references: [id], onDelete: Cascade)

  @@index([sourceDocId])
  @@index([targetDocId])
  @@index([targetBlockId])
}

model DocRevision {
  id        String          @id @default(cuid())
  docId     String
  title     String
  path      String?
  markdown  String
  html      String
  content   Json?
  actorType ActionActorType
  reason    String
  createdAt DateTime        @default(now())

  doc Doc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([docId, createdAt(sort: Desc)])
}

model DocShare {
  id        String   @id @default(cuid())
  docId     String   @unique
  slug      String   @unique
  shareUrl  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doc Doc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([slug])
}

enum TaskStatus {
  waiting
  started
  deferred
  complete
  cancelled
}

enum ArchivedPageCaptureMode {
  bulk
  targeted
}

enum ArchiveCanvasCardMode {
  compact
  summary
  rich
}

model TaskList {
  id        String     @id @default(cuid())
  name      String
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  tasks     TaskItem[]

  @@index([sortOrder])
}

model TaskItem {
  id              String     @id @default(cuid())
  listId          String
  description     String
  status          TaskStatus @default(waiting)
  dueDate         DateTime?
  durationMinutes Int?
  tags            String[]   @default([])
  meta            Json?
  parentTaskId    String?
  sortOrder       Int        @default(0)
  // The note block this task lives in when it was written inline in a note.
  sourceDocId     String?
  sourceBlockId   String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  list       TaskList   @relation(fields: [listId], references: [id], onDelete: Cascade)
  sourceDoc  Doc?       @relation(fields: [sourceDocId], references: [id], onDelete: SetNull)
  parentTask TaskItem?  @relation("TaskHierarchy", fields: [parentTaskId], references: [id], onDelete: SetNull)
  childTasks TaskItem[] @relation("TaskHierarchy")

  @@index([listId])
  @@index([parentTaskId])
  @@index([status])
  @@index([dueDate])
  @@index([listId, parentTaskId, sortOrder])
  @@index([sourceDocId])
}

model TimeBlock {
  id          String   @id @default(cuid())
  title       String?
  startTime   DateTime
  endTime     DateTime
  color       String?
  isFixedTime Boolean  @default(false)
  comments    String?
  noteId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  note Doc? @relation(fields: [noteId], references: [id], onDelete: SetNull)

  @@index([startTime])
  @@index([noteId])
}

model ArchivedPage {
  id             String                @id @default(cuid())
  normalizedUrl  String                @unique
  originalUrl    String
  title          String
  siteHostname   String?
  groupName      String?
  lastCapturedAt DateTime?
  canvasX        Float?
  canvasY        Float?
  canvasCardMode ArchiveCanvasCardMode @default(summary)
  meta           Json?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  snapshots ArchivedPageSnapshot[]
  notes     ArchivedPageNote[]

  @@index([siteHostname])
  @@index([groupName])
  @@index([lastCapturedAt(sort: Desc)])
}

model ArchivedCanvasNode {
  id           String                 @id @default(cuid())
  groupName    String
  kind         ArchivedCanvasNodeKind
  contentHtml  String?
  imageUrl     String?
  canvasX      Float
  canvasY      Float
  canvasWidth  Float
  canvasHeight Float
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([groupName, updatedAt(sort: Desc)])
}

model ArchivedPageSnapshot {
  id               String                  @id @default(cuid())
  archivedPageId   String
  captureMode      ArchivedPageCaptureMode
  capturedAt       DateTime
  title            String?
  groupName        String?
  htmlPath         String?
  htmlHash         String?
  meta             Json?
  textSnippet      String?
  extensionPayload Json?
  createdAt        DateTime                @default(now())

  archivedPage ArchivedPage       @relation(fields: [archivedPageId], references: [id], onDelete: Cascade)
  notes        ArchivedPageNote[]

  @@index([archivedPageId, capturedAt(sort: Desc)])
  @@index([groupName])
  @@index([capturedAt(sort: Desc)])
  @@index([htmlHash])
}

model ArchivedPageNote {
  id             String   @id @default(cuid())
  archivedPageId String
  snapshotId     String?
  noteText       String
  imageUrls      String[] @default([])
  sourceContext  Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  archivedPage ArchivedPage          @relation(fields: [archivedPageId], references: [id], onDelete: Cascade)
  snapshot     ArchivedPageSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)

  @@index([archivedPageId, createdAt(sort: Desc)])
  @@index([snapshotId])
}

model TimeBlockDayMetadata {
  id          String   @id @default(cuid())
  date        DateTime
  key         String
  value       String
  contributor String   @default("default")
  comments    String?
  noteId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  note Doc? @relation(fields: [noteId], references: [id], onDelete: SetNull)

  @@unique([date, key, contributor])
  @@index([date])
  @@index([key])
  @@index([noteId])
}

/// Append-only audit/event log for major user/system actions.
model ActionEvent {
  id           String          @id @default(cuid())
  createdAt    DateTime        @default(now())
  eventType    String
  actorId      String?
  actorType    ActionActorType @default(anonymous)
  entityType   String
  entityId     String?
  relatedDocId String?
  sessionId    String?
  requestId    String?
  payload      Json?

  relatedDoc Doc? @relation("RelatedDocEvents", fields: [relatedDocId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([relatedDocId, createdAt(sort: Desc)])
  @@index([eventType, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
}

/// Per-doc daily counters used for rolling activity windows.
model DocActivityDaily {
  id               String   @id @default(cuid())
  docId            String
  date             DateTime
  viewCount        Int      @default(0)
  editCount        Int      @default(0)
  searchClickCount Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  doc Doc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@unique([docId, date])
  @@index([date])
  @@index([docId, date(sort: Desc)])
}

/// Cached 30-day rollup for ranking and filtering.
model DocActivitySnapshot {
  id               String              @id @default(cuid())
  docId            String              @unique
  views30d         Int                 @default(0)
  edits30d         Int                 @default(0)
  searchClicks30d  Int                 @default(0)
  lastViewedAt     DateTime?
  lastEditedAt     DateTime?
  lastInteractedAt DateTime?
  activityClass    ActionActivityClass @default(COLD)
  updatedAt        DateTime            @updatedAt

  doc Doc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([lastInteractedAt(sort: Desc)])
}

/// Structural sections/chunks of a Doc after preprocessing
model DocSection {
  id          String   @id @default(cuid())
  docId       String
  headingPath String[] @default([])
  text        String // @db.Text
  contentHash String
  orderIndex  Int
  charCount   Int
  tokenCount  Int?

  doc        Doc                   @relation(fields: [docId], references: [id], onDelete: Cascade)
  embeddings DocSectionEmbedding[]

  @@unique([docId, contentHash])
  @@index([docId, orderIndex])
}

/// Vector embedding run metadata
model EmbeddingRun {
  id        String   @id @default(cuid())
  model     String
  dims      Int
  params    Json?
  createdAt DateTime @default(now())

  docEmbeddings        DocEmbedding[]
  docSectionEmbeddings DocSectionEmbedding[]
  UmapRun              UmapRun[]
}

/// Embedding vector for a full Doc under a specific EmbeddingRun
model DocEmbedding {
  id           String   @id @default(cuid())
  runId        String
  docId        String
  vector       Float[]
  contentHash  String?
  sectionCount Int?
  tokenCount   Int?
  createdAt    DateTime @default(now())

  run EmbeddingRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  doc Doc          @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@unique([runId, docId])
  @@index([docId])
  @@index([contentHash])
}

/// Embedding vector for a specific DocSection under a given EmbeddingRun
model DocSectionEmbedding {
  id         String   @id @default(cuid())
  runId      String
  docId      String
  sectionId  String
  vector     Float[]
  tokenCount Int?
  createdAt  DateTime @default(now())

  run     EmbeddingRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  doc     Doc          @relation(fields: [docId], references: [id], onDelete: Cascade)
  section DocSection   @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([runId, sectionId])
  @@index([docId])
}

/// UMAP projection run over a given EmbeddingRun
model UmapRun {
  id               String    @id @default(cuid())
  embeddingRunId   String
  dims             Int
  params           Json?
  artifactPath     String?
  regionsJson      Json?
  regionsUpdatedAt DateTime?
  /// Similarity transform into the frame of the map this run replaced; applied to every projected point.
  alignment        Json?
  /// Notes the model was trained on; the retrain trigger counts projections beyond it.
  trainedDocCount  Int?
  createdAt        DateTime  @default(now())

  embeddingRun EmbeddingRun @relation(fields: [embeddingRunId], references: [id], onDelete: Cascade)
  points       UmapPoint[]

  @@index([embeddingRunId, createdAt])
}

/// Coordinates for each Doc in a UMAP projection run
model UmapPoint {
  id    String @id @default(cuid())
  runId String
  docId String
  x     Float
  y     Float
  z     Float?

  run UmapRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  doc Doc     @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@unique([runId, docId])
  @@index([docId])
}

/// --- Chat (Threaded) ---

enum ChatThreadStatus {
  ACTIVE
  LOADING
  DONE
}

enum ChatMessageRole {
  user
  assistant
}

model ChatThread {
  id            String           @id @default(cuid())
  userId        String
  noteId        String
  title         String
  status        ChatThreadStatus @default(ACTIVE)
  hasUnread     Boolean          @default(false)
  lastMessageAt DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  messages ChatMessage[]

  @@index([userId, lastMessageAt])
  @@index([noteId, lastMessageAt])
}

model ChatMessage {
  id          String          @id @default(cuid())
  threadId    String
  role        ChatMessageRole
  contentHtml String
  isEdited    Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

/// OAuth client registered by an MCP client (e.g. ChatGPT) via dynamic
/// client registration. Public clients only; PKCE is mandatory.
model OAuthClient {
  id           String   @id
  clientName   String?
  redirectUris String[]
  createdAt    DateTime @default(now())

  codes  OAuthAuthorizationCode[]
  grants OAuthGrant[]
}

/// Single-use authorization code, stored hashed; valid for a few minutes.
model OAuthAuthorizationCode {
  codeHash      String   @id
  clientId      String
  redirectUri   String
  codeChallenge String
  resource      String
  scope         String
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

/// An approved connection. Access tokens carry its id, so revoking the grant
/// cuts off the client immediately. The refresh token rotates on every use.
model OAuthGrant {
  id               String    @id @default(cuid())
  clientId         String
  scope            String
  resource         String
  refreshTokenHash String    @unique
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime?
  revokedAt        DateTime?

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

enum CollectionPropertyKind {
  text
  number
  select
  status
  multi_select
  date
  checkbox
  created_time
  updated_time
}

enum CollectionViewType {
  table
  board
  gallery
  calendar
}

/// A typed set of notes (Notion-style database). Rows are Docs.
model Collection {
  id          String    @id @default(cuid())
  name        String
  description String?
  icon        String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  properties CollectionProperty[]
  views      CollectionView[]
  rows       Doc[]
  feeds      CalendarFeed[]

  @@index([deletedAt, updatedAt])
}

model CollectionProperty {
  id           String                 @id @default(cuid())
  collectionId String
  name         String
  kind         CollectionPropertyKind
  /// Options, display format, and other per-kind settings.
  config       Json                   @default("{}")
  position     Int
  deletedAt    DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([collectionId, position])
}

model CollectionView {
  id           String             @id @default(cuid())
  collectionId String
  /// Set when the view is embedded in a note; such views are not page tabs.
  hostDocId    String?
  name         String
  type         CollectionViewType @default(table)
  /// Filters, sorts, visible properties, widths, grouping, and cover settings.
  config       Json               @default("{}")
  position     Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  collection Collection     @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  hostDoc    Doc?           @relation("CollectionViewHost", fields: [hostDocId], references: [id], onDelete: SetNull)
  feeds      CalendarFeed[]

  @@index([collectionId, position])
  @@index([hostDocId])
}

// ── Research threads ────────────────────────────────────────────────────────
// One topic = one canvas. Cards carry a single came-from parent; relates-to
// links and summary groups are separate layers. Every agent write is a batch
// so it can be undone as a unit (soft-hide via hiddenAt, never hard delete).

enum ResearchCardType {
  task
  question
  finding
  source
  summary
  option
  criterion
}

enum ResearchCardState {
  open
  done
  dropped
}

enum ResearchSummaryStatus {
  draft
  accepted
}

model ResearchTopic {
  id         String    @id @default(cuid())
  slug       String    @unique
  title      String
  archivedAt DateTime?
  /// The topic's current answer (markdown), kept up to date by agents.
  answer     String    @default("")
  /// Declared card kinds: [{ key, label, role, fields: [{ key, label }] }].
  kinds      Json      @default("[]")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  cards    ResearchCard[]
  links    ResearchLink[]
  groups   ResearchSummaryGroup[]
  batches  ResearchBatch[]
  streams  ResearchStream[]
  comments ResearchComment[]
}

/// A parallel thread inside a topic. Cards join one explicitly or through
/// their came-from ancestor; the board draws one column per stream.
model ResearchStream {
  id        String    @id @default(cuid())
  topicId   String
  key       String
  title     String
  goal      String    @default("")
  /// The stream's current answer (markdown).
  answer    String    @default("")
  sortOrder Int       @default(0)
  batchId   String?
  hiddenAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  topic    ResearchTopic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  batch    ResearchBatch?    @relation(fields: [batchId], references: [id], onDelete: SetNull)
  cards    ResearchCard[]
  comments ResearchComment[]

  @@unique([topicId, key])
  @@index([topicId])
}

/// A note left on a card or stream for the next agent pass to read and resolve.
model ResearchComment {
  id         String    @id @default(cuid())
  topicId    String
  cardId     String?
  streamId   String?
  body       String
  author     String    @default("you")
  resolvedAt DateTime?
  /// What the agent did about it, shown under the comment.
  resolution String?
  createdAt  DateTime  @default(now())

  topic  ResearchTopic   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  card   ResearchCard?   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  stream ResearchStream? @relation(fields: [streamId], references: [id], onDelete: Cascade)

  @@index([topicId, resolvedAt])
  @@index([cardId])
}

model ResearchBatch {
  id        String    @id @default(cuid())
  topicId   String
  batchKey  String
  agent     String
  summary   String    @default("")
  // Stored ingest result (ref → id map, counts) and reversible state changes.
  result    Json?
  createdAt DateTime  @default(now())
  undoneAt  DateTime?

  topic   ResearchTopic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  cards   ResearchCard[]
  links   ResearchLink[]
  groups  ResearchSummaryGroup[]
  streams ResearchStream[]

  @@unique([topicId, batchKey])
  @@index([topicId, createdAt])
}

model ResearchCard {
  id        String             @id @default(cuid())
  topicId   String
  type      ResearchCardType
  title     String
  /// One or two sentences shown on the board; body holds the long form.
  gist      String             @default("")
  body      String             @default("")
  /// A kind declared on the topic (its role is `type`).
  kind      String?
  /// Values for the kind's fields, { key: text }.
  fields    Json?
  /// Explicit stream; null inherits from the came-from ancestor.
  streamId  String?
  state     ResearchCardState?
  url       String?
  snippet   String?
  imageUrl  String?
  parentId  String?
  sortOrder Int                @default(0)
  nudgeX    Float?
  nudgeY    Float?
  batchId   String?
  hiddenAt  DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  topic       ResearchTopic           @relation(fields: [topicId], references: [id], onDelete: Cascade)
  batch       ResearchBatch?          @relation(fields: [batchId], references: [id], onDelete: SetNull)
  parent      ResearchCard?           @relation("ResearchCardPedigree", fields: [parentId], references: [id], onDelete: SetNull)
  children    ResearchCard[]          @relation("ResearchCardPedigree")
  linksFrom   ResearchLink[]          @relation("ResearchLinkFrom")
  linksTo     ResearchLink[]          @relation("ResearchLinkTo")
  summaryOf   ResearchSummaryGroup?
  memberships ResearchSummaryMember[]
  stream      ResearchStream?         @relation(fields: [streamId], references: [id], onDelete: SetNull)
  comments    ResearchComment[]

  @@index([topicId, hiddenAt])
  @@index([parentId])
  @@index([batchId])
  @@index([streamId])
}

model ResearchLink {
  id        String    @id @default(cuid())
  topicId   String
  fromId    String
  toId      String
  kind      String    @default("relates_to")
  batchId   String?
  hiddenAt  DateTime?
  createdAt DateTime  @default(now())

  topic ResearchTopic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  from  ResearchCard   @relation("ResearchLinkFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to    ResearchCard   @relation("ResearchLinkTo", fields: [toId], references: [id], onDelete: Cascade)
  batch ResearchBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([topicId])
  @@index([fromId])
  @@index([toId])
}

model ResearchSummaryGroup {
  id            String                @id @default(cuid())
  topicId       String
  summaryCardId String                @unique
  status        ResearchSummaryStatus @default(draft)
  batchId       String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  topic       ResearchTopic           @relation(fields: [topicId], references: [id], onDelete: Cascade)
  summaryCard ResearchCard            @relation(fields: [summaryCardId], references: [id], onDelete: Cascade)
  batch       ResearchBatch?          @relation(fields: [batchId], references: [id], onDelete: SetNull)
  members     ResearchSummaryMember[]

  @@index([topicId])
}

model ResearchSummaryMember {
  groupId String
  cardId  String

  group ResearchSummaryGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  card  ResearchCard         @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([groupId, cardId])
  @@index([cardId])
}

// ── Events + iCal feeds ─────────────────────────────────────────────────────
// An event is a note: `Event` holds the details an iCal entry needs and the
// note-level decision; each dated show is an `EventOccurrence`. Feeds pick
// events by rule (collection view filter + decisions) plus manual entries.

enum EventDecision {
  unreviewed
  interested
  tentative
  booked
  skipped
  rejected
}

enum OccurrenceStatus {
  scheduled
  cancelled
  postponed
  sold_out
}

enum PlaceKind {
  venue
  restaurant
  shop
  other
}

enum FeedEntryMode {
  include
  exclude
}

model Event {
  id           String        @id @default(cuid())
  docId        String        @unique
  /// Official or ticket link; becomes the iCal URL.
  url          String?
  /// Short plain-text blurb for calendar entries (no visual-notes link).
  summary      String?
  /// Default place for shows that do not set their own.
  placeId      String?
  decision     EventDecision @default(unreviewed)
  decisionNote String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  doc         Doc                 @relation(fields: [docId], references: [id], onDelete: Cascade)
  place       Place?              @relation(fields: [placeId], references: [id], onDelete: SetNull)
  occurrences EventOccurrence[]
  feedEntries CalendarFeedEntry[]

  @@index([placeId])
}

model EventOccurrence {
  id            String           @id @default(cuid())
  eventId       String
  label         String?
  startsAt      DateTime
  endsAt        DateTime?
  allDay        Boolean          @default(false)
  /// False publishes the show as an all-day "time TBD" entry.
  timeConfirmed Boolean          @default(true)
  timeZone      String           @default("America/Indiana/Indianapolis")
  placeId       String?
  ticketStatus  String?
  status        OccurrenceStatus @default(scheduled)
  decision      EventDecision    @default(unreviewed)
  decisionNote  String?
  /// Note block this show was written from, when it came from note content.
  sourceBlockId String?
  /// iCal SEQUENCE; bumped whenever published fields change.
  sequence      Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  event Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  place Place? @relation(fields: [placeId], references: [id], onDelete: SetNull)

  @@index([startsAt])
  @@index([eventId, startsAt])
  @@index([placeId])
}

model Place {
  id             String    @id @default(cuid())
  name           String
  normalizedName String
  kind           PlaceKind @default(venue)
  street         String?
  city           String?
  state          String?
  postalCode     String?
  latitude       Float?
  longitude      Float?
  url            String?
  notes          String?
  /// Optional note with the write-up for this place.
  docId          String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  doc         Doc?              @relation(fields: [docId], references: [id], onDelete: SetNull)
  events      Event[]
  occurrences EventOccurrence[]

  @@index([normalizedName])
  @@index([kind])
}

model CalendarFeed {
  id           String          @id @default(cuid())
  name         String
  description  String?
  /// Secret in the subscribe URL `/cal/<token>.ics`; rotate to revoke.
  token        String          @unique
  /// Rule: events whose notes are rows of this collection...
  collectionId String?
  /// ...that match this view's filter (absent = every row)...
  viewId       String?
  /// ...with an effective decision in this set (empty = any).
  decisions    EventDecision[] @default([])
  /// Past shows kept in the feed.
  pastDays     Int             @default(90)
  deletedAt    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  collection Collection?         @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  view       CollectionView?     @relation(fields: [viewId], references: [id], onDelete: SetNull)
  entries    CalendarFeedEntry[]

  @@index([deletedAt])
}

model CalendarFeedEntry {
  feedId    String
  eventId   String
  mode      FeedEntryMode
  createdAt DateTime      @default(now())

  feed  CalendarFeed @relation(fields: [feedId], references: [id], onDelete: Cascade)
  event Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([feedId, eventId])
  @@index([eventId])
}
