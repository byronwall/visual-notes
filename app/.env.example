MAGIC_PASSWORD=***
OPENAI_API_KEY=***
AUTH_SECRET=***

VITE_AUTH_PATH=/api/auth

AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3000
DB_HOST=localhost
DB_NAME=bible
DB_PASSWORD=postgres
DB_PORT=5432
DB_PORT_EXPOSED=5432:5432
DB_USER=postgres

DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public

# ChatGPT MCP connector (see docs/mcp-connector.md)
MCP_CONNECTOR_ENABLED=false
# openssl rand -hex 32
MCP_TOKEN_SECRET=
# Public https origin, e.g. https://notes.example.com (token issuer/audience)
PUBLIC_BASE_URL=
# Local-only bearer for the MCP Inspector; ignored in production
MCP_DEV_TOKEN=

# Live note updates over /ws/notes (see app/docs/live-note-updates.md); "false" turns them off
NOTE_LIVE_SYNC=
